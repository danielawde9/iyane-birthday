# ── Iyane Birthday Site — environment variables ─────────────────────────────
# Copy to ".env.local" for local dev, and set the same in Vercel for production.
# With NONE of these set, the app runs in DEMO MODE (seeded content, in-memory
# writes, demo party code "1234", admin open locally). Set them for real use.

# ── Supabase (Database + Storage + Auth) ────────────────────────────────────
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; NEVER expose to the client

# Postgres connection string for Drizzle. Use the POOLED "Transaction" string
# (port 6543) from Supabase → Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Public Storage bucket name (create it in Supabase → Storage). Default: photos
SUPABASE_STORAGE_BUCKET=photos

# ── Upload gate ─────────────────────────────────────────────────────────────
# Party code (OPTIONAL). Leave EMPTY to let any guest in Lebanon upload with no code.
# Set a value to require guests to type it first. (UPLOAD_REQUIRE_PIN=1/0 forces on/off.)
UPLOAD_PIN=
COOKIE_SIGNING_KEY=change-me-to-a-long-random-string   # signs the upload cookie (only used if a PIN is set)
# Lebanon-only access is handled by Cloudflare in front of the app (no app-level geo check).
# UPLOAD_TOKEN_TTL_MS=43200000        # optional: unlock duration (default 12h)

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAILS=you@example.com          # comma-separated emails allowed into /admin
# ADMIN_DEV_BYPASS=0                   # set 0 to force real admin auth even locally

# ── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://iyaneawde.com   # used for OG image + QR poster URLs
